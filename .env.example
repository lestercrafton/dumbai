# ------------------------------------------------------------------
# Ovanova Scheduling — environment variables
# Copy this file to `.env` and fill in values.
# ------------------------------------------------------------------

# Public URL where this app is hosted (no trailing slash)
NEXT_PUBLIC_APP_URL="https://scheduling.ovanova.co"

# Database — local dev uses SQLite, prod uses Postgres (Neon/Supabase/etc)
# Dev example:    file:./dev.db
# Prod example:   postgresql://user:pass@host:5432/ovanova_scheduling
DATABASE_URL="file:./dev.db"

# Auth — NextAuth secret (generate: `openssl rand -base64 32`)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Quick admin login (credentials provider — simple for local dev)
ADMIN_EMAIL="lester@ovanova.co"
ADMIN_PASSWORD="changeme"

# Google OAuth (login + Google Calendar + Google Meet)
# Create at https://console.cloud.google.com — OAuth client (Web)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft OAuth (Outlook calendar)
# Create at https://entra.microsoft.com
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Transactional email — Resend (https://resend.com)
RESEND_API_KEY=""

# Stripe (optional — only if you offer paid consultations)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
