    },
    "eligibility": "Regular-season completed non-tied MLB games only. Exclude known suspended/resumed games if exact time of stat availability cannot be established. Require both teams>=10 eligible prior completed games. Report every missing/unmatched/excluded game. Do not exclude games for large errors or absent prices.",
    "chronology": {
      "day": "UTC date of game start.",
      "embargo": "For a target on UTC dateD, every input result/stat must come from a game with UTC start date<=D\u22122. This full-day buffer avoids ordinary overnight-completion ambiguity. Known suspension/resumption cases excluded unless availability established. No same-day doubleheader input.",
      "baselineFit": "Daily prequential score-rating refit on the same embargoed historical rows, asOfD, no future team coefficients.",
      "residualLabels": "Each historical target residual equals actual margin minus its own genuinely prequential active prediction, not an in-sample full-history fitted value.",
      "residualFit": "At each Monday UTC block cutoffC, fit only historical labeled rows with target date<=C\u22122, within730 days, minimum500 eligible labels. During later validation coefficients may refit under the frozen rule using only then-past outcomes; feature family/window/penalty never retuned.",
      "standardization": "Fit feature medians, means and standard deviations from only the same prior residual-training rows. Missing values imputed by those training medians with missingness indicators. Intercept unpenalized; other standardized coefficients ridge-penalized.",
      "workloadWindowClarification": "Three-day staff workload means three eligible calendar dates ending D\u22122 (D\u22124,D\u22123,D\u22122); seven-day game count similarly uses D\u22128 throughD\u22122. Yesterday remains embargoed. This specifies implementation before fitting."
    },
    "features": {
      "common": [
        "active prequential predicted margin, allowing a fitted calibration slope correction"
      ],
      "runs": [
        "home-minus-away rolling runs scored per game",
        "away-minus-home rolling runs allowed per game"
      ],
      "boxscore": [
        "home-minus-away batting hits,walks,strikeouts,home-runs per plate appearance",
        "away-minus-home pitching hits,walks,strikeouts,home-runs allowed per recorded out"
      ],
      "context": [
        "home-minus-away pitching staff workload:outs and pitches in prior3 calendar days, under the same embargo",
        "home-minus-away prior7 calendar day game count",
        "prior730-day venue total-run environment relative to league total runs,smoothed by100 venue games,and its interaction with active margin"
      ],
      "venueLimit": "This is an empirical venue run-environment proxy,not an official causal park factor. It uses only past dates; no full-season park factors.",
      "bullpenLimit": "Use exact historical relief innings/pitches only if collector provides defensible splits. Otherwise staff workload is explicitly a proxy and never called bullpen innings. No costly inferred starter splits.",
      "starterPolicy": "No target starter/player identity from retroactively fetched final probablePitcher or actual starter fields. No historical pregame snapshots exist here; no target starter feature.",
      "excludedFutureFeatures": [
        "days_until_next_game",
        "season-end totals or future-season averages",
        "current full-season park factors",
        "pitch locations or strike zones with2026 definition breaks"
      ]
    },
