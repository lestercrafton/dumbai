// Cloudflare Workers (free plan) target for Big Vin. See docs/cloudflare-move.md.
// Build first (npm run build); this deploys dist/ as one Worker with static assets and D1.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "big-vin",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": { "directory": "dist/client" },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The runner requests a GitHub OIDC token with this audience when it writes here.
  "vars": { "COLLECTOR_AUDIENCE": "https://big-vin.sitetime.workers.dev" },
  // The site reads env.DB through cloudflare:workers (lib/db.ts), so the binding name stays DB.
  // Created October 19, 2026 in Lester's Cloudflare account; separate from the other projects there.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "big-vin",
      "database_id": "aa66b317-ad92-48d4-842a-fcfc4f63e56d",
      "migrations_dir": "drizzle"
    }
  ]
}
