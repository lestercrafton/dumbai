// Cloudflare Workers (free plan) target for Big Vin. See docs/cloudflare-move.md.
// Build first (npm run build); this deploys dist/ as one Worker with static assets and D1.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "big-vin",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": { "directory": "dist/client" },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The site reads env.DB through cloudflare:workers (lib/db.ts), so the binding name stays DB.
  // Replace database_id with the id printed by `wrangler d1 create big-vin`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "big-vin",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ]
}
