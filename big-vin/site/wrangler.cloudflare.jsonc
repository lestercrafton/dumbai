// Cloudflare Workers (free plan) target for Big Vin. See docs/cloudflare-move.md.
// Build first (npm run build:cloudflare); this deploys dist/ as one Worker with static assets and D1.
// The entry is cloudflare/edge.mjs: precomputed public reads from D1, everything else to the app.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "big-vin",
  "main": "dist/server/edge.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": { "directory": "dist/client" },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Workers Cache: repeat requests for the read-cache routes are answered at the edge
  // without running the Worker (cloudflare/edge.mjs sets the edge-only directive).
  "cache": { "enabled": true },
  // The home page HTML is cached per deployment, so a new deploy never serves old asset links.
  "version_metadata": { "binding": "CF_VERSION" },
  // The runner requests a GitHub OIDC token with this audience when it writes here.
  "vars": { "COLLECTOR_AUDIENCE": "https://big-vin.lestercrafton.workers.dev" },
  // The site reads env.DB through cloudflare:workers (lib/db.ts), so the binding name stays DB.
  // Created October 19, 2026 in Lester's Cloudflare account; separate from the other projects there.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "big-vin",
      "database_id": "b35ed0e6-909d-496b-ab8c-1583d982f462",
      "migrations_dir": "drizzle"
    }
  ]
}
