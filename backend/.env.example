# Copy this file to .env and fill in your values

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── App Config ────────────────────────────────────────────────────────────────
# Random secret for signing JWT tokens (run: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-secret-key

# URL where this app is running (no trailing slash)
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite by default, no setup needed
DATABASE_URL=sqlite:///./calendly.db
